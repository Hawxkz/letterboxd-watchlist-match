# TMDB (The Movie Database) API Configuration
# Get your free TMDB API key here: https://www.themoviedb.org/settings/api
# Copy this file to '.env' and enter your key:
TMDB_API_KEY=

# Preferred language for genres and titles (e.g. en-US, de-DE)
TMDB_LANGUAGE=en-US

# ==========================================
# Security & Rate Limiting Configuration
# ==========================================
# Maximum watchlist comparison requests per minute per IP (default: 15)
RATE_LIMIT_MATCH_PER_MINUTE=15

# Maximum general API requests per minute per IP (default: 60)
RATE_LIMIT_GENERAL_PER_MINUTE=60

# Optional: Allowed CORS origins (comma-separated, default: http://localhost:5173,http://127.0.0.1:5173)
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

